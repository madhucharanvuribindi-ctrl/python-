print("Hollow Number Diamond")

try:
    rows = int(input("Enter the number of rows: "))

    if rows < 1:
        print("Enter a number greater than 0.")
    else:
        # Top half
        for i in range(1, rows + 1):
            print(" " * (rows - i), end="")
            print(i, end="")

            if i > 1:
                print(" " * (2 * i - 3), end="")
                print(i, end="")

            print()

        # Bottom half
        for i in range(rows - 1, 0, -1):
            print(" " * (rows - i), end="")
            print(i, end="")

            if i > 1:
                print(" " * (2 * i - 3), end="")
                print(i, end="")

            print()

except ValueError:
    print("Please enter a whole number.")